# Copier en backend/.env pour lancer l'API en local. Ne jamais commiter le vrai .env.

# Base PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gendon

# Clerk (comptes) : Dashboard Clerk > API keys
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://<instance>.clerk.accounts.dev/.well-known/jwks.json
# Secret du webhook (Dashboard Clerk > Webhooks), événements user.updated et user.deleted
CLERK_WEBHOOK_SECRET=whsec_...
# Origines autorisées à obtenir un jeton (contrôle « azp »). Vide = contrôle désactivé
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Identifiant(s) Clerk des administrateurs principaux, séparés par des virgules
ADMIN_USER_ID=user_...

# Site Next.js : CORS et liens dans les emails (plusieurs adresses séparées par des virgules)
FRONTEND_URL=http://localhost:3000

# Cloudinary (photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (emails)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
# Adresse qui reçoit le formulaire de contact à la place de celle des admins principaux
CONTACT_EMAIL=

# Clé de signature des liens de désabonnement (chaîne aléatoire longue)
NEWSLETTER_SECRET=

# Optionnel : documentation /docs (1 = activée, à garder désactivée en production) et niveau des journaux
ENABLE_DOCS=1
LOG_LEVEL=INFO
